{
  "family": "inventory-management-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "inventory-management-service",
      "image": "ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/inventory-management-service:latest",
      "portMappings": [
        {
          "containerPort": 8004,
          "hostPort": 8004,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-1"
        },
        {
          "name": "DYNAMODB_INVENTORY_TABLE",
          "value": "inventory"
        },
        {
          "name": "JWT_SECRET_KEY",
          "value": "smartretailx-super-secret-jwt-key-2024"
        },
        {
          "name": "SQS_QUEUE_URL",
          "value": "https://sqs.ap-southeast-1.amazonaws.com/ACCOUNT_ID/orders-queue"
        },
        {
          "name": "NOTIFICATION_QUEUE_URL",
          "value": "https://sqs.ap-southeast-1.amazonaws.com/ACCOUNT_ID/notification-queue"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/inventory-management-service",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8004/api/v1/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "essential": true
    }
  ]
}
